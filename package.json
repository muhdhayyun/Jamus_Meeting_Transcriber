{
  "name": "jamus",
  "version": "0.6.0",
  "description": "Local, privacy-first meeting transcriber. Records your mic + system audio separately and produces a speaker-separated Markdown transcript using local Whisper. No cloud, no API keys.",
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "jamus": "bin/jamus.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "app": "node scripts/start-app.mjs",
    "start": "node bin/jamus.js",
    "devices": "node bin/jamus.js devices",
    "record": "node bin/jamus.js record",
    "run": "node bin/jamus.js run",
    "build": "node scripts/build-whisper.mjs && node scripts/build-wasapi.mjs",
    "build:whisper": "node scripts/build-whisper.mjs",
    "build:whisper:cuda": "node scripts/build-whisper.mjs --cuda",
    "build:wasapi": "node scripts/build-wasapi.mjs",
    "package": "electron-builder --dir",
    "package:installer": "electron-builder --win nsis"
  },
  "keywords": [
    "meeting",
    "transcriber",
    "whisper",
    "transcription",
    "local",
    "offline",
    "speaker-separation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dayjs": "^1.11.13",
    "nodejs-whisper": "^0.2.9",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.jamus.app",
    "productName": "Jamus",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "compression": "store",
    "files": [
      "bin/**/*",
      "electron/**/*",
      "src/**/*",
      "config/**/*",
      "native/**/*",
      "vendor/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/.bin/**/*"
    ],
    "win": {
      "target": "dir"
    }
  }
}
